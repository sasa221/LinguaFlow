# Required server-side secret. Add this in Vercel Project Settings > Environment Variables.
# Never expose it with a VITE_ prefix.
GEMINI_API_KEY="your_gemini_api_key"

# Optional canonical app URL, for example:
# APP_URL="https://your-project.vercel.app"
APP_URL=""

# Vercel sets VERCEL=1 automatically at runtime. Do not set it manually.
